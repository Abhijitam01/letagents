# Postgres connection string. Neon, Supabase, or any Postgres host.
DATABASE_URL=

# Public site URL used for metadata, the sitemap, and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth signing secret. Generate one locally; do not commit a real value.
BETTER_AUTH_SECRET=

# Base URL Better Auth uses for callbacks. No trailing slash.
BETTER_AUTH_URL=http://localhost:3000
